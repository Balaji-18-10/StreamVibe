# ==============================================================================
# STREAMVIBE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and replace placeholders with production values.
# Do NOT commit production credentials or secrets to version control.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/youtube_clone?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/youtube_clone?retryWrites=true&w=majority

# JWT Token Secrets (Generate high-entropy 64-byte random hex keys: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_min_64_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_min_64_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Client URLs (comma-separated list for multiple domains)
# Example: https://streamvibe.vercel.app,http://localhost:5173
CLIENT_URL=https://streamvibe.vercel.app

# Rate Limiting & Proxy Configuration
# TRUST_PROXY: Number of upstream reverse proxy hops to trust (1 for Render, Heroku, AWS ALB)
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
