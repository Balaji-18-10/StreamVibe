# ==============================================================================
# STREAMVIBE CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or set in Vercel Project Environment Variables.
# All client variables MUST start with VITE_ to be exposed to Vite client build.
# ==============================================================================

# Backend API Base URL
# In production on Vercel: Set to your hosted backend URL with /api/v1 suffix.
# Example: https://streamvibe-api.onrender.com/api/v1
# In local development: Leave blank to use Vite development proxy (/api/v1)
VITE_API_BASE_URL=https://streamvibe-api.onrender.com/api/v1

# Socket.IO Real-Time Server URL
# In production on Vercel: Set to your hosted backend origin.
# Example: https://streamvibe-api.onrender.com
# In local development: Defaults to http://localhost:5000
VITE_SOCKET_URL=https://streamvibe-api.onrender.com
